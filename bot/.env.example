# Copy to bot/.env (gitignored) and fill in. NEVER commit a real key.
# Keys come from the SportsPredict app: Profile & History -> My Bots -> Generate New Bot.
# The key is shown only once.
#
# Both keys must belong to the SAME account. A second account voids every entry
# (Grand Slam Challenge Official Rules, Section 5).

# Lane 1 - the honest model. This is the main leaderboard entry.
SPORTSPREDICT_API_KEY=sp_live_your_key_here

# Lane 2 - the de-correlated scenario bot (optional).
SPORTSPREDICT_API_KEY_SCENARIO=sp_live_your_second_key_here

# Optional overrides
# SPORTSPREDICT_BASE_URL=https://api.sportspredict.com/api/v1
# SPORTSPREDICT_EVENT_MATCH=grand slam
