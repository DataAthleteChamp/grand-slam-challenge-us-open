# Copy to bot/.env (gitignored) only when reproducing authenticated read-only
# history queries. NEVER commit a real key.
#
# The 2026 event is archived and the CLI rejects --submit.

# Lane 1 - Quant_Researcher.
SPORTSPREDICT_API_KEY=sp_live_your_key_here

# Lane 2 - T-shirt Hunter.
SPORTSPREDICT_API_KEY_SCENARIO=sp_live_your_second_key_here

# Optional overrides
# SPORTSPREDICT_BASE_URL=https://api.sportspredict.com/api/v1
# SPORTSPREDICT_EVENT_MATCH=grand slam

# Optional historical bookmaker refresh. Not needed for the offline final report.
ODDS_API_KEY=your_odds_api_key_here
